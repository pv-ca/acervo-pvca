---
import Poster from "./Poster.astro";
import { getI18n } from "../lib/i18n";
import { copyAccessGroups, copyAccessHeading, formatGiB } from "../lib/catalog";
import { selections } from "../data/selections";
import type { CatalogPreviewFilm } from "../data/catalog-preview";
interface Props {
  film: CatalogPreviewFilm;
}
const { film } = Astro.props;
const { lang, t, path } = getI18n(Astro.url);
const { groups, remainingLinks } = copyAccessGroups(film);
const copies = groups.map((group) => group.copy);
const copyLinks = new Map(groups.map((group) => [group.copy.id, group.links]));
const sourceHeading = (_copy: (typeof copies)[number], index: number) =>
  copyAccessHeading(groups, index, t);
const originalTitle =
  film.originalTitle && film.originalTitle !== film.title
    ? film.originalTitle
    : null;
const romanizedTitle =
  film.romanizedTitle &&
  film.romanizedTitle !== film.title &&
  film.romanizedTitle !== film.originalTitle
    ? film.romanizedTitle
    : null;
const facts = [
  [t("Direção"), film.director],
  [t("Ano"), String(film.year)],
  film.country && [t("País"), film.country],
  film.runtimeMinutes && [t("Duração"), `${film.runtimeMinutes} min`],
  Boolean(film.genres?.length) && [t("Gênero"), film.genres!.map(t).join(", ")],
  Boolean(film.originalLanguages?.length) && [
    t("Idioma original"),
    film.originalLanguages!.join(", "),
  ],
].filter(Boolean) as [string, string][];
const memberSelections = selections.filter((selection) =>
  selection.films.some((member) => member.slug === film.slug)
);
---

<main id="main" class="film-detail">
  <div class="wrap detail-shell">
    <a class="back-link" href={path("/filmes/")}>
      {t("← Filmes")}
    </a>
    <div class="detail-grid">
      <div class="film-title-block detail-heading">
        <h1>{film.title}</h1>
        {originalTitle && <p class="original-title">{originalTitle}</p>}
        {romanizedTitle && <p class="romanized-title">{romanizedTitle}</p>}
        <p class="film-detail-meta">
          {[film.director, String(film.year), film.country]
            .filter(Boolean)
            .join(" · ")}
        </p>
      </div>
      <div class="detail-poster">
        <Poster film={film} eager />
      </div>
      <div class="detail-editorial">
        {film.synopsis && (
          <div class="detail-synopsis">
            <h2 class="eyebrow">{t("Sinopse")}</h2>
            {film.synopsis.split("\n\n").map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )}
        <dl class="detail-facts">
          {facts.map(([name, value]) => (
            <>
              <dt>{name}</dt>
              <dd>{value}</dd>
            </>
          ))}
        </dl>
        {film.collectionNote && (
          <section class="detail-note">
            <h2 class="eyebrow">{t("Nota do acervo")}</h2>
            <p>{film.collectionNote}</p>
          </section>
        )}
      </div>
      <section class="archive-card" aria-labelledby="archive-heading">
        <h2 id="archive-heading" class="eyebrow">
          {t("No acervo")}
        </h2>
        {copies.length ? (
          copies.map((copy, index) => (
            <article class="archive-copy">
              {(film.copies?.length ?? 0) > 1 && (
                <h3>{sourceHeading(copy, index)}</h3>
              )}
              <p class="copy-spec">
                {[
                  copy.resolution,
                  copy.sizeGiB != null ? formatGiB(copy.sizeGiB, lang) : null,
                ]
                  .filter(Boolean)
                  .join(" · ") || t("Dados técnicos pendentes")}
              </p>
              <dl class="archive-languages">
                {Boolean(copy.audio?.length) && (
                  <>
                    <dt>{t("Áudio")}</dt>
                    <dd>
                      {copy
                        .audio!.map((value) =>
                          value === "root" || value === "und"
                            ? t("Não informado")
                            : t(value)
                        )
                        .join(", ")}
                    </dd>
                  </>
                )}
                {Boolean(copy.subtitles?.length) && (
                  <>
                    <dt>{t("Legendas")}</dt>
                    <dd>{copy.subtitles!.map(t).join(", ")}</dd>
                  </>
                )}
                {copy.edition && (
                  <>
                    <dt>{t("Versão")}</dt>
                    <dd>{copy.edition}</dd>
                  </>
                )}
              </dl>
              {Boolean(copyLinks.get(copy.id)?.length) && (
                <div class="copy-access-actions">
                  {(copyLinks.get(copy.id) ?? []).map((link) => (
                    <a href={link.url} rel="external" class="archive-action">
                      <span>
                        {t("Ver no")} {t(link.provider)}
                      </span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              )}
            </article>
          ))
        ) : (
          <p class="copy-pending">
            {t("Dados da cópia ainda não importados.")}
          </p>
        )}
        <div class="archive-actions">
          {remainingLinks.map((link) => {
            const copy = film.copies?.find((copy) => copy.id === link.copyId);
            return (
              <a href={link.url} rel="external" class="archive-action">
                <span>
                  {t("Ver no")} {t(link.provider)}
                  {copies.length > 1 && copy?.label && (
                    <small>{copy.label}</small>
                  )}
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            );
          })}
          <button
            type="button"
            class="archive-action"
            data-share
            data-title={film.title}
            data-share-label={t("Compartilhar filme")}
            data-copied-label={t("Link copiado")}
            data-error-label={t("Copie o endereço desta página")}
          >
            <span data-share-text>{t("Compartilhar filme")}</span>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <rect x="8" y="8" width="12" height="13" rx="2" />
              <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h3" />
            </svg>
          </button>
          <p class="share-feedback" aria-live="polite" hidden></p>
          <input
            class="share-url"
            aria-label={t("Link do filme")}
            readonly
            hidden
          />
        </div>
      </section>
    </div>
    {memberSelections.length > 0 && (
      <section class="detail-selections">
        <h2 class="eyebrow">{t("Também aparece em")}</h2>
        <div class="selection-grid">
          {memberSelections.map((selection) => (
            <a href={path(`/selecoes/${selection.id}/`)}>
              <div class="selection-card-posters" aria-hidden="true">
                {selection.films.slice(0, 3).map((member) => (
                  <Poster film={member} decorative />
                ))}
              </div>
              <div class="selection-card-copy">
                <span>
                  {t(selection.localized?.[lang]?.title || selection.title)}
                </span>
                <small>
                  {selection.films.length} {t("filmes")}{" "}
                  <span aria-hidden="true">↗</span>
                </small>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</main>
<script>
  const share = document.querySelector<HTMLButtonElement>("[data-share]");
  share?.addEventListener("click", async () => {
    const url =
      document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href ??
      location.href;
    const feedback = document.querySelector<HTMLElement>(".share-feedback");
    const manual = document.querySelector<HTMLInputElement>(".share-url");
    if (feedback) {
      feedback.hidden = true;
      feedback.textContent = "";
    }
    if (manual) manual.hidden = true;
    share.disabled = true;
    try {
      if (navigator.share)
        await navigator.share({ title: share.dataset.title, url });
      else {
        await navigator.clipboard.writeText(url);
        if (feedback) {
          feedback.textContent = share.dataset.copiedLabel ?? "";
          feedback.hidden = false;
        }
      }
    } catch (error) {
      if (!(error instanceof Error && error.name === "AbortError")) {
        if (feedback) {
          feedback.textContent = share.dataset.errorLabel ?? "";
          feedback.hidden = false;
        }
        if (manual) {
          manual.value = url;
          manual.hidden = false;
          manual.focus();
          manual.select();
        }
      }
    } finally {
      share.disabled = false;
    }
  });
</script>
<style>
  :global(body:has(.detail-grid)) {
    --content-max: 1240px;
  }
  .film-detail {
    padding-bottom: 48px;
  }
  .detail-shell {
    padding-top: 48px;
  }
  .back-link {
    min-height: 44px;
    margin-bottom: 32px;
  }
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 240px) minmax(0, 1fr) minmax(0, 290px);
    grid-template-rows: min-content 1fr;
    column-gap: 40px;
    row-gap: 32px;
    align-items: start;
  }
  .detail-heading {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }
  .detail-heading h1 {
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .detail-heading .original-title {
    line-height: 1.45;
  }
  .romanized-title {
    color: var(--color-text-muted);
    font-size: 16px;
    margin: 0 0 8px;
  }
  .film-detail-meta {
    font-size: 16px;
    line-height: 1.6;
  }
  .detail-poster {
    grid-column: 1;
    grid-row: 1 / span 2;
  }
  .detail-poster :global(.poster) {
    display: block;
    width: 100%;
    height: auto;
  }
  .detail-editorial {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
  }
  .eyebrow {
    font-size: 12px;
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 500;
    color: var(--color-text-muted);
    margin: 0 0 16px;
  }
  .detail-synopsis p,
  .detail-note p {
    font-size: 16px;
    line-height: 1.7;
    margin: 0;
  }
  .detail-facts {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 12px 20px;
    font-size: 15px;
    line-height: 1.6;
    margin: 32px 0 0;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }
  .detail-facts dt {
    color: var(--color-text-muted);
  }
  .detail-facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .detail-note {
    margin-top: 32px;
  }
  .archive-card {
    grid-column: 3;
    grid-row: 1 / span 2;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 24px;
    min-width: 0;
  }
  .archive-card > h2 {
    margin-bottom: 24px;
  }
  .archive-copy + .archive-copy {
    margin-top: 24px;
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
  }
  .archive-copy h3 {
    font-size: 15px;
    font-weight: 560;
    margin: 0 0 16px;
  }
  .copy-spec {
    color: var(--color-text-head);
    font-size: 18px;
    margin: 0 0 24px;
    line-height: 1.5;
  }
  .archive-languages {
    margin: 20px 0 0;
  }
  .archive-languages dt {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin: 20px 0 6px;
  }
  .archive-languages dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .copy-access-actions {
    display: grid;
    gap: 12px;
    margin-top: 24px;
  }
  .archive-actions {
    border-top: 1px solid var(--color-border);
    margin-top: 24px;
    padding-top: 20px;
    display: grid;
    gap: 12px;
  }
  .archive-action {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 48px;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 12px;
    background: var(--color-bg-1);
    color: var(--color-text-head);
    font-size: 14px;
    text-align: left;
  }
  .archive-action:hover,
  .archive-action:active {
    border-color: var(--color-text-muted);
  }
  .share-feedback {
    color: var(--color-text-muted);
    font-size: 14px;
    margin: 0;
  }
  .share-url {
    width: 100%;
    min-width: 0;
    padding: 8px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-body);
  }
  .archive-action:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .archive-action small {
    display: block;
    color: var(--color-text-muted);
    margin-top: 4px;
  }
  .archive-action svg {
    flex-shrink: 0;
  }
  .detail-selections {
    margin-top: 48px;
    border-top: 1px solid var(--color-border);
    padding-top: 32px;
  }
  .selection-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .selection-grid a {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
    color: var(--color-text-head);
  }
  .selection-card-posters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--color-border);
  }
  .selection-card-posters :global(.poster) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    border-radius: 0;
  }
  .selection-card-copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    gap: 16px;
    padding: 20px;
  }
  .selection-grid a:hover {
    border-color: var(--color-text-muted);
  }
  .selection-grid small {
    color: var(--color-text-muted);
    font-size: 14px;
  }
  @media (max-width: 1100px) and (min-width: 761px) {
    .detail-grid {
      grid-template-columns: 180px minmax(0, 1fr) 250px;
      column-gap: 24px;
    }
    .detail-heading h1 {
      font-size: 44px;
    }
    .archive-card {
      padding: 20px;
    }
    .detail-facts {
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 10px 16px;
    }
  }
  @media (max-width: 900px) and (min-width: 761px) {
    .detail-grid {
      grid-template-columns: 180px minmax(0, 1fr);
    }
    .archive-card {
      grid-column: 2;
      grid-row: 3;
    }
    .selection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .detail-shell {
      padding-top: 24px;
    }
    .back-link {
      margin-bottom: 24px;
    }
    .detail-grid {
      grid-template-rows: none;
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .detail-heading,
    .detail-poster,
    .detail-editorial,
    .archive-card {
      grid-column: 1;
      grid-row: auto;
    }
    .detail-heading {
      order: 0;
    }
    .detail-poster {
      order: 1;
      max-width: 230px;
      width: 100%;
      justify-self: center;
    }
    .detail-editorial {
      order: 2;
    }
    .archive-card {
      order: 3;
      padding: 24px;
    }
    .detail-heading h1 {
      font-size: clamp(36px, 10vw, 44px);
    }
    .detail-facts {
      font-size: 16px;
      grid-template-columns: 105px minmax(0, 1fr);
      gap: 12px 16px;
    }
    .archive-languages dd {
      font-size: 16px;
    }
    .archive-action {
      font-size: 15px;
    }
    .detail-selections {
      margin-top: 40px;
    }
    .selection-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .selection-grid a {
      min-height: 100px;
    }
  }
</style>
