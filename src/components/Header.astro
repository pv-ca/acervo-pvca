---
import { getI18n } from "../lib/i18n";
const { lang, t, path, languageHref } = getI18n(Astro.url);

interface Props {
  active?: "home" | "films" | "selections" | "howto" | "about" | "none";
}
const { active = "home" } = Astro.props;
const links = [
  { id: "home", href: "/", label: t("Início") },
  { id: "films", href: "/filmes/", label: t("Filmes") },
  { id: "selections", href: "/selecoes/", label: t("Seleções") },
  { id: "howto", href: "/como-baixar/", label: t("Como baixar") },
  { id: "about", href: "/sobre/", label: t("Sobre") },
];
---

<a class="skip-link" href="#main">
  {t("Ir para o conteúdo")}
</a>
<header class="site-header">
  <div class="wrap top">
    <a class="name" href={path("/")}>
      Acervo PVCA
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-label={t("Abrir menu")}
      aria-expanded="false"
      aria-controls="main-navigation"
      hidden
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav id="main-navigation" aria-label={t("Navegação principal")}>
      {links.map((link) => (
        <a
          href={path(link.href)}
          class:list={{ active: active === link.id }}
          aria-current={active === link.id ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
      <span class="language-switch" role="group" aria-label={t("Idioma")}>
        <a
          href={languageHref("pt-BR")}
          data-language="pt-BR"
          aria-current={lang === "pt-BR" ? "page" : undefined}
          lang="pt-BR"
          hreflang="pt-BR"
        >
          PT
        </a>
        <a
          href={languageHref("en")}
          data-language="en"
          aria-current={lang === "en" ? "page" : undefined}
          lang="en"
          hreflang="en"
        >
          EN
        </a>
      </span>
    </nav>
  </div>
</header>
<script>
  import { translate } from "../../scripts/i18n/public.mjs";
  const t = (text: string) => translate(document.documentElement.lang, text);
  const header = document.querySelector<HTMLElement>(".site-header")!;
  const toggle = header.querySelector<HTMLButtonElement>(".menu-toggle")!;
  const nav = header.querySelector<HTMLElement>("nav")!;
  const main = document.querySelector<HTMLElement>("main");
  const footer = document.querySelector<HTMLElement>("footer");
  toggle.hidden = false;
  header.classList.add("menu-ready");
  function setOpen(open: boolean) {
    header.classList.toggle("menu-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute(
      "aria-label",
      open ? t("Fechar menu") : t("Abrir menu")
    );
    document.body.classList.toggle("menu-open", open);
    if (main) main.inert = open;
    if (footer) footer.inert = open;
  }
  toggle.addEventListener("click", () =>
    setOpen(toggle.getAttribute("aria-expanded") !== "true")
  );
  header.addEventListener("keydown", (event) => {
    if (toggle.getAttribute("aria-expanded") !== "true") return;
    if (event.key === "Escape") {
      setOpen(false);
      toggle.focus();
    }
    if (event.key === "Tab") {
      const items = [
        header.querySelector<HTMLAnchorElement>(".name")!,
        toggle,
        ...nav.querySelectorAll<HTMLAnchorElement>("a"),
      ];
      const first = items[0],
        last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });
  matchMedia("(min-width: 641px)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });
</script>
