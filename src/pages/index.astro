---
import { getI18n, localizeFilm, assetPath } from "../lib/i18n";
const { lang, t, path } = getI18n(Astro.url);

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Poster from "../components/Poster.astro";
import CollectionStats from "../components/CollectionStats.astro";
import DecadeChart from "../components/DecadeChart.astro";
import {
  featuredFilm as sourceFeatured,
  recentFilms as sourceRecent,
} from "../data/home";
import { selections } from "../data/selections";
import { editorial } from "../data/editorial";
const featuredFilm = sourceFeatured
  ? localizeFilm(sourceFeatured, lang)
  : undefined;
const recentFilms = sourceRecent.map((film) => localizeFilm(film, lang));
---

<BaseLayout
  glow={featuredFilm?.poster ? assetPath(featuredFilm.poster) : undefined}
  description={t(
    "Acervo pessoal de cinema: filmes, cópias preservadas e seleções para explorar."
  )}
>
  <Header active="home" />
  <main id="main">
    <section class={`wrap intro${featuredFilm ? " intro-with-film" : ""}`}>
      <h1>{t("Meu acervo pessoal de cinema.")}</h1>
      <p>
        {t(
          "Filmes que venho reunindo, preservando e organizando ao longo do tempo."
        )}
      </p>
      <a class="intro-explore" href={path("/filmes/")}>
        {t("Filmes")} <span aria-hidden="true">→</span>
      </a>
      {featuredFilm && (
        <a class="intro-film" href={path(`/filmes/${featuredFilm.slug}/`)}>
          <Poster film={featuredFilm} eager decorative />
          <span class="intro-film-caption">
            <span>{t("Em destaque")}</span>
            <strong>{featuredFilm.title}</strong>
            {featuredFilm.director} · {featuredFilm.year} ·{" "}
            {featuredFilm.country}
          </span>
        </a>
      )}
      {editorial.showStats && (
        <div class="intro-stats">
          <CollectionStats />
        </div>
      )}
    </section>
    {recentFilms.length > 0 && (
      <>
        <div class="wrap rule"></div>
        <section class="wrap section">
          <div class="section-title">
            <h2>{t("Recentemente")}</h2>
            <span>{t("últimas adições")}</span>
          </div>
          <div class="recent-films">
            {recentFilms.map((film) => (
              <a href={path(`/filmes/${film.slug}/`)}>
                <Poster film={film} decorative />
                <h3>{film.title}</h3>
                <p>
                  {film.director} · {film.year}
                </p>
              </a>
            ))}
          </div>
        </section>
      </>
    )}
    <div class="wrap rule"></div>
    <section class="wrap section">
      <div class="section-title">
        <h2>{t("Seleções")}</h2>
      </div>
      <div class="home-selections">
        {editorial.homeSelectionIds
          .flatMap((id) =>
            selections.filter(
              (selection) => selection.id === id && selection.films.length
            )
          )
          .map((selection) => (
            <a href={path(`/selecoes/${selection.id}/`)}>
              <h3>
                {t(selection.localized?.[lang]?.title || selection.title)}
              </h3>
              <p>
                {t(
                  selection.localized?.[lang]?.description ||
                    selection.description
                )}
              </p>
              <span>{t("Ver seleção →")}</span>
            </a>
          ))}
      </div>
    </section>
    {editorial.showStats && (
      <>
        <div class="wrap rule"></div>
        <section class="wrap section">
          <DecadeChart />
        </section>
      </>
    )}
  </main>
  <Footer />
</BaseLayout>
