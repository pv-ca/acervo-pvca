---
import { getI18n, assetPath } from "../lib/i18n";
const { t } = getI18n(Astro.url);

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const profile = "https://archive.org/details/@pv_ca/uploads";
const shot = (name: string) => assetPath(`/images/como-baixar/${name}.png`);
---

<BaseLayout
  title={`${t("Como baixar um filme")} — Acervo PVCA`}
  description={t(
    "Passo a passo, com prints, para baixar um filme do Acervo PVCA no Internet Archive."
  )}
>
  <Header active="howto" />
  <main id="main">
    <section class="wrap page-head">
      <h1>{t("Como baixar um filme")}</h1>
      <p>
        {t("Quatro passos, sem cadastro e sem programa extra. O exemplo usa")}
        <em>Black Orpheus</em>
        {t("(1959), enviado ao Internet Archive pelo perfil")}
        <a href={profile}>pv_ca</a>.
      </p>
    </section>
    <div class="wrap">
      <ol class="steps">
        <li>
          <h2>{t("Chegue à página do filme")}</h2>
          <p>
            {t(
              "Na ficha do filme aqui no Acervo, use o link do Internet Archive: ele abre a página certa e você pode pular para o passo 2. Se preferir, abra o"
            )}
            <a href={profile}>{t("perfil pv_ca")}</a>
            {t("e procure o título na caixa “Search uploads”.")}
          </p>
          <figure>
            <div class="shot">
              <img
                src={shot("1-perfil")}
                alt={t(
                  "Perfil pv_ca no Internet Archive com a lista de uploads"
                )}
                width="1280"
                height="800"
                loading="lazy"
              />
              <div
                class="hl"
                style="left:70.3%;top:46.5%;width:25.5%;height:5.5%"
              >
                <span class="below">{t("Busque o título aqui")}</span>
              </div>
            </div>
            <figcaption>
              {t(
                "O perfil lista todos os filmes enviados, do mais recente ao mais antigo."
              )}
            </figcaption>
          </figure>
        </li>
        <li>
          <h2>{t("Veja o tamanho antes de baixar")}</h2>
          <p>
            {t("Na página do filme, confira o")} <b>Item Size</b>.
            {t(
              "Os filmes do Acervo costumam ser de alta qualidade, mas o tamanho muda de filme para filme: pode ser pequeno, grande ou muito grande. Saber antes evita ficar sem espaço no disco no meio do download."
            )}
          </p>
          <figure>
            <div class="shot">
              <img
                src={shot("3-opcoes-download")}
                alt={t(
                  "Página do filme Black Orpheus mostrando Item Size 24.6G"
                )}
                width="1280"
                height="800"
                loading="lazy"
              />
              <div class="hl" style="left:8.6%;top:45.8%;width:30%;height:3.6%">
                <span>{t("Item Size: 24.6G (neste filme)")}</span>
              </div>
            </div>
          </figure>
        </li>
        <li>
          <h2>{t("Veja as opções em “Download Options”")}</h2>
          <p>
            {t("No painel à direita ficam os formatos disponíveis")}
            <b>{t("para aquele filme")}</b>.
            {t("Nem todos os filmes têm as mesmas opções, e o")}
            <b>MATROSKA</b>
            {t(
              "(.mkv), que aparece neste exemplo, pode não ser o único. Veja o que existe e confira o tamanho de cada opção para saber se está baixando a coisa certa."
            )}
          </p>
          <figure>
            <div class="shot">
              <img
                src={shot("3-opcoes-download")}
                alt={t(
                  "Painel Download Options com ITEM IMAGE, ITEM TILE, MATROSKA, TORRENT, 7 Files e 7 Original"
                )}
                width="1280"
                height="800"
                loading="lazy"
              />
              <div
                class="hl"
                style="left:67.8%;top:47.6%;width:25.4%;height:27.4%"
              >
                <span>{t("Formatos disponíveis")}</span>
              </div>
            </div>
          </figure>
          <table>
            <thead>
              <tr>
                <th>{t("Opção")}</th>
                <th>{t("O que é")}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>MATROSKA, MPEG4…</td>
                <td>
                  {t(
                    "O filme em um único arquivo de vídeo. Pode haver mais de um formato; compare os tamanhos."
                  )}
                </td>
              </tr>
              <tr>
                <td>TORRENT</td>
                <td>
                  {t(
                    "Sempre disponível. Baixa o filme por um programa de torrent, bom para arquivos grandes e conexões instáveis."
                  )}
                </td>
              </tr>
              <tr>
                <td>7 Original</td>
                <td>
                  {t(
                    "Lista só os arquivos enviados originalmente, cada um com seu tamanho."
                  )}
                </td>
              </tr>
              <tr>
                <td>7 Files</td>
                <td>
                  {t(
                    "Lista todos os arquivos do item, inclusive os gerados pelo Archive."
                  )}
                </td>
              </tr>
              <tr>
                <td>ITEM IMAGE, ITEM TILE</td>
                <td>{t("Só o cartaz do filme. Não é o filme.")}</td>
              </tr>
            </tbody>
          </table>
        </li>
        <li>
          <h2>{t("Salve o arquivo")}</h2>
          <p>
            {t(
              "Ao clicar em um formato (ou em “7 Original” ou “7 Files”), o navegador abre a lista de arquivos, com o tamanho de cada um na coluna “Size”. Clique no nome do arquivo do filme, aqui terminado em"
            )}
            <code>.mkv</code>
            {t(
              ", e o download começa. Se o navegador tentar abrir em vez de baixar, clique com o botão direito no link e escolha"
            )}
            <b>{t("Salvar link como…")}</b>.
          </p>
          <figure>
            <div class="shot">
              <img
                src={shot("4-lista-arquivos")}
                alt={t(
                  "Lista de arquivos do item com o arquivo .mkv destacado"
                )}
                width="1280"
                height="800"
                loading="lazy"
              />
              <div
                class="hl"
                style="left:6.8%;top:33.2%;width:47.5%;height:3.2%"
              >
                <span>black-orpheus-1959-1080p-pvca.mkv · 24.6 GB</span>
              </div>
            </div>
            <figcaption>
              {t("O arquivo")} <code>.torrent</code>
              {t(
                ", logo abaixo, é a alternativa para baixar pelo programa de torrent."
              )}
            </figcaption>
          </figure>
          <p class="tip">
            <b>{t("Pronto.")}</b>
            {t(
              "O arquivo vai para a pasta Downloads. Se a conexão cair, clique no mesmo link de novo: o navegador costuma retomar de onde parou."
            )}
          </p>
        </li>
      </ol>
    </div>
    <section class="wrap faq" aria-labelledby="faq-h">
      <p class="eyebrow">{t("Dúvidas")}</p>
      <h2 id="faq-h">{t("Perguntas frequentes")}</h2>
      <details>
        <summary>{t("Quanto tempo leva?")}</summary>
        <p>
          {t(
            "Depende do tamanho do filme e da sua internet: um arquivo de 24 GB em uma conexão de 100 Mbps leva cerca de 35 minutos. Deixe o computador ligado e sem suspender."
          )}
        </p>
      </details>
      <details>
        <summary>{t("Como abro um arquivo .mkv?")}</summary>
        <p>
          {t("Use o")} <a href="https://www.videolan.org/">VLC</a>
          {t(
            ", que toca .mkv no computador e no celular. Nenhum codec extra é necessário."
          )}
        </p>
      </details>
      <details>
        <summary>{t("Como ativo a legenda?")}</summary>
        <p>
          {t(
            "As legendas já estão dentro do arquivo. No VLC, abra o menu Legenda → Faixa de legenda e escolha o idioma (a página do filme lista quais existem)."
          )}
        </p>
      </details>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-head h1 {
    max-width: 16ch;
  }
  .page-head a,
  li p a,
  details p a {
    color: var(--color-text-head);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  ol.steps {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: s;
  }
  ol.steps > li {
    counter-increment: s;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 0 24px;
    padding: 40px 0;
    border-top: 1px solid var(--color-border);
  }
  ol.steps > li::before {
    content: counter(s);
    grid-row: 1 / span 6;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--ivory-fill);
    color: var(--ivory-ink);
    box-shadow: var(--ivory-raise);
    font-weight: 700;
    font-size: 15px;
    display: grid;
    place-items: center;
  }
  ol.steps > li > * {
    grid-column: 2;
  }
  ol.steps h2 {
    font-size: 28px;
    letter-spacing: -0.035em;
    line-height: 1.15;
    margin: 0 0 12px;
  }
  li p {
    max-width: 70ch;
    font-size: 15px;
  }
  code {
    font-size: 0.92em;
    color: var(--color-text-head);
  }
  figure {
    margin: 10px 0 0;
  }
  .shot {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    line-height: 0;
  }
  .shot img {
    width: 100%;
    height: auto;
    display: block;
  }
  /* Black box, ivory text: the site's own colors; the ivory outline keeps the box visible on dark parts of a print. */
  .hl {
    position: absolute;
    border: 3px solid var(--color-bg);
    border-radius: 6px;
    outline: 2px solid var(--color-text-head);
    box-shadow: 0 0 0 9999px rgba(16, 15, 15, 0.45);
  }
  .hl span {
    position: absolute;
    left: -3px;
    top: -34px;
    background: var(--color-bg);
    color: var(--color-text-head);
    font:
      600 13px/1 Inter,
      system-ui,
      sans-serif;
    padding: 6px 9px;
    border-radius: 5px;
    white-space: nowrap;
  }
  .hl span.below {
    top: auto;
    bottom: -34px;
  }
  figcaption {
    font-size: 12px;
    color: var(--color-text-muted);
    margin-top: 10px;
  }
  .tip {
    margin: 20px 0 0;
    padding: 14px 16px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font-size: 14px;
  }
  .tip b {
    color: var(--color-text-head);
  }
  table {
    border-collapse: collapse;
    width: 100%;
    max-width: 70ch;
    font-size: 14px;
    margin: 20px 0 0;
  }
  th,
  td {
    text-align: left;
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  th {
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 12px;
  }
  td:first-child {
    color: var(--color-text-head);
    white-space: nowrap;
    padding-right: 24px;
  }
  .faq {
    padding: 40px 0 64px;
    border-top: 1px solid var(--color-border);
  }
  .faq h2 {
    font-size: 20px;
    margin-bottom: 18px;
  }
  details {
    border-top: 1px solid var(--color-border);
    padding: 16px 0;
  }
  details:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  summary {
    cursor: pointer;
    color: var(--color-text-head);
    font-weight: 580;
  }
  summary:focus-visible {
    outline: 2px solid var(--color-text-head);
    outline-offset: 4px;
  }
  details p {
    margin: 10px 0 0;
    max-width: 70ch;
    font-size: 14px;
    color: var(--color-text-muted);
  }
  @media (max-width: 640px) {
    ol.steps h2 {
      font-size: 24px;
    }
    ol.steps > li {
      grid-template-columns: minmax(0, 1fr);
    }
    ol.steps > li::before {
      grid-row: auto;
      margin-bottom: 14px;
    }
    ol.steps > li > * {
      grid-column: 1;
    }
    td:first-child {
      white-space: normal;
    }
  }
</style>
