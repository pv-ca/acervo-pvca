---
import { getI18n, assetPath } from "../lib/i18n";
const { t } = getI18n(Astro.url);

import { isPreview, catalog } from "../data/catalog";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CollectionStats from "../components/CollectionStats.astro";
import LetterboxdDiary from "../components/LetterboxdDiary.astro";
const posters = catalog.filter((film) => film.poster);
const step = Math.max(1, Math.floor(posters.length / 18));
const collage = posters.filter((_, index) => index % step === 0).slice(0, 18);
const networks = [
  { name: "X", handle: "@vaidadehumana", url: "https://x.com/vaidadehumana" },
  {
    name: "Letterboxd",
    handle: "@pvca",
    url: "https://letterboxd.com/pvca/",
    note: "Diário de filmes e notas",
  },
  {
    name: "Instagram",
    handle: "@paulovcaragao",
    url: "https://www.instagram.com/paulovcaragao/",
  },
  {
    name: "Rate Your Music",
    handle: "@pvca",
    url: "https://rateyourmusic.com/~pvca",
    note: "Música",
  },
];
---

<BaseLayout
  title={`${t("Sobre")} — Acervo PVCA`}
  description={t(
    "Conheça a história e a organização do Acervo PVCA, minha coleção pessoal de cinema."
  )}
>
  <Header active="about" />
  <main id="main" class="about-main">
    <div class="about-collage" aria-hidden="true">
      {collage.map((film) => (
        <img
          src={assetPath(film.poster!)}
          alt=""
          width="200"
          height="300"
          loading="lazy"
        />
      ))}
    </div>
    <section class="wrap page-head">
      <h1>{t("Sobre")}</h1>
    </section>
    <div class="wrap about-intro">
      <p>
        {t(
          "Comecei o Acervo PVCA para organizar minha coleção de filmes. Com o tempo, ela passou a incluir diferentes cópias das obras, legendas revisadas e informações sobre cada filme."
        )}
      </p>
      <p>
        {t(
          "Você pode consultar a coleção neste site. As fichas trazem informações sobre os filmes e suas cópias preservadas. Nas minhas seleções, reúno obras por temas e interesses em comum."
        )}
      </p>
    </div>
    <div class="wrap rule"></div>
    <div class="wrap about-columns">
      <section>
        <h2>{t("Os filmes e suas cópias")}</h2>
        <p>
          {t(
            "Na ficha de cada filme, você encontra informações sobre direção, ano, país e duração, além da resolução, do tamanho, do áudio e das legendas da cópia preservada. Os detalhes de outras versões ou edições do acervo ficam na mesma página."
          )}
        </p>
        <p>
          {t("Os links disponíveis levam às cópias que escolhi compartilhar.")}
          {isPreview &&
            t(
              " Nesta prévia, pôsteres e dados ainda não importados permanecem indicados como pendentes."
            )}
        </p>
      </section>
      <section>
        <h2>{t("Minhas redes sociais")}</h2>
        <ul class="social-cards">
          {networks.map((network) => (
            <li>
              <a href={network.url} rel="me">
                <span class="social-name">
                  {network.name} <span aria-hidden="true">↗</span>
                </span>
                <span class="social-handle">{network.handle}</span>
                {network.note && (
                  <span class="social-note">{t(network.note)}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
    <LetterboxdDiary />
    <div class="wrap rule"></div>
    <section class="wrap section">
      <h2>{t("O acervo em números")}</h2>
      <CollectionStats />
    </section>
    <div class="wrap section tmdb-credit">
      <a href="https://www.themoviedb.org/" aria-label="TMDB">
        <img
          src={assetPath("/credits/tmdb.svg")}
          alt="TMDB"
          width="93"
          height="67"
          loading="lazy"
        />
      </a>
      <p>
        {t("Metadados e pôsteres obtidos do TMDB quando disponíveis.")}
        <br />
        This product uses the TMDB API but is not endorsed or certified by TMDB.
      </p>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .tmdb-credit {
    display: flex;
    align-items: center;
    gap: 24px;
    border-top: 1px solid var(--color-border);
  }
  .tmdb-credit img {
    filter: grayscale(1) brightness(0) invert(1);
    max-width: none;
  }
  .tmdb-credit p {
    font-size: 0.875rem;
    color: #9f9d96;
  }
  @media (max-width: 600px) {
    .tmdb-credit {
      align-items: flex-start;
      gap: 16px;
    }
    .tmdb-credit img {
      width: 70px;
      height: auto;
    }
  }
</style>
