---
import { getI18n, localizeFilm, assetPath } from "../../lib/i18n";
const { lang } = getI18n(Astro.url);

import { catalog as catalogPreview } from "../../data/catalog";
import FilmDetail from "../../components/FilmDetail.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { type CatalogPreviewFilm } from "../../data/catalog-preview";

export function getStaticPaths() {
  return catalogPreview.map((film) => ({
    params: { slug: film.slug },
    props: { film },
  }));
}

interface Props {
  film: CatalogPreviewFilm;
}

const film = localizeFilm(Astro.props.film, lang);
---

<BaseLayout
  image={film.poster ? assetPath(film.poster) : undefined}
  glow={film.poster ? assetPath(film.poster) : undefined}
  title={`${film.title} — Acervo PVCA`}
  description={`${film.title}, ${film.director}, ${film.year} ${lang === "en" ? "in" : "no"} Acervo PVCA.`}
>
  <Header active="films" />

  <FilmDetail film={film} />

  <Footer />
</BaseLayout>
