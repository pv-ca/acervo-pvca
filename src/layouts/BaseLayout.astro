---
import { getI18n } from "../lib/i18n";
const { lang, t, languageHref } = getI18n(Astro.url);

import "../styles/global.css";
const site = Astro.site ?? Astro.url;
const canonical = new URL(languageHref(lang), site);
const alternateHref = (locale: string) => new URL(languageHref(locale), site);

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Poster whose blurred light sits behind the top of the page. */
  glow?: string;
}

const {
  title = "Acervo PVCA",
  description = t("Meu acervo pessoal de cinema."),
  image,
  noindex = false,
  glow,
} = Astro.props;
const defaultSocialImage =
  import.meta.env.BASE_URL.replace(/\/$/, "") + "/images/acervo-pvca-share.png";
const socialImage = new URL(image ?? defaultSocialImage, site);
const socialImageAlt = image
  ? t(title)
  : lang === "en"
    ? "Acervo PVCA illustration"
    : "Ilustração do Acervo PVCA";
---

<!doctype html>
<html lang={lang} data-theme="flexoki-dark">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#100f0f" />
    <meta name="color-scheme" content="dark" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={
        new URL(
          import.meta.env.BASE_URL.replace(/\/$/, "") + "/favicon.svg",
          site
        )
      }
    />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <title>{t(title)}</title>
    <meta property="og:title" content={t(title)} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Acervo PVCA" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "pt_BR"} />
    <meta
      property="og:locale:alternate"
      content={lang === "en" ? "pt_BR" : "en_US"}
    />
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={t(title)} />
    <meta name="twitter:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {!image && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="400" />
        <meta property="og:image:height" content="400" />
      </>
    )}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={alternateHref("pt-BR")} />
    <link rel="alternate" hreflang="en" href={alternateHref("en")} />
  </head>
  <body>
    {glow && (
      <div
        class="poster-glow"
        aria-hidden="true"
        style={`--glow-image: url("${glow}")`}
      />
    )}
    <slot />
    <script>
      // Explicit language URLs are authoritative. Record preference only on manual navigation.
      for (const link of document.querySelectorAll<HTMLAnchorElement>(
        "[data-language]"
      )) {
        link.addEventListener("click", () => {
          try {
            localStorage.setItem("pvca-language", link.dataset.language!);
          } catch {}
          const target = new URL(link.href, location.href);
          target.search = location.search;
          target.hash = location.hash;
          link.href = target.href;
        });
      }
    </script>
  </body>
</html>
